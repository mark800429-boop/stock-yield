# ============================================================
# 通用 .gitignore 範本（Windows + Python + Node + Office + CAD）
# 建立日期：2026-07-28
# 用途：任何專案 git init 前先放這份，避免金鑰與暫存檔外流
# ============================================================

# ------------------------------------------------------------
# 1. 金鑰與憑證（最重要，外流等於帳號被接管）
# ------------------------------------------------------------
.env
.env.*
*.key
*.pem
*.pfx
*.p12
secrets.json
credentials.json

# Google OAuth 相關（行事曆／Gmail 整合會產生）
*token*.json
*creds*.json
client_secret*.json
calendar_token.json
calendar_creds.json
gmail_send_token.json

# 例外：範本檔要進版控，讓別人知道需要哪些變數
!.env.example
!.env.template

# ------------------------------------------------------------
# 2. Claude Code 個人設定（settings.json 內含 API 金鑰）
# ------------------------------------------------------------
.claude/
.claude/settings.json
.claude/settings.local.json
*.backup.*
AI工作記憶/

# 註：專案根目錄的 CLAUDE.md 與 AGENTS.md 通常「要」進版控，
#     它們是給 AI 的專案說明書，不含機密，故不列入忽略。

# ------------------------------------------------------------
# 3. Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ------------------------------------------------------------
# 4. Node.js
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.next/
.cache/

# ------------------------------------------------------------
# 5. Office 暫存與鎖定檔
# ------------------------------------------------------------
~$*.xlsx
~$*.xlsm
~$*.docx
~$*.dotm
~$*.pptx
*.tmp
*.laccdb

# ------------------------------------------------------------
# 6. CAD／BIM 暫存與備份
# ------------------------------------------------------------
*.bak
*.dwl
*.dwl2
*.sv$
*.ac$
*.err
*.rws
*.[0-9][0-9][0-9][0-9].rvt
*.skb

# ------------------------------------------------------------
# 7. Windows 系統檔
# ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------------------------------------
# 8. 誤建檔案（PowerShell 重導向打錯時會產生）
# ------------------------------------------------------------
nul
NUL
C:temp*

# ------------------------------------------------------------
# 9. 大型輸出（視專案需要開關）
# ------------------------------------------------------------
# *.mp4
# *.mov
# output/
# 待清理/
